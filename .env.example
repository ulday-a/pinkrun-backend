# Скопируйте этот файл в .env и заполните реальными значениями.
# На Render эти же переменные вводятся в разделе Environment — сам .env туда не грузится.

# --- База данных ---
# Строка подключения к Postgres. Render/Neon/Supabase дают её в личном кабинете базы.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Домен сайта (для CORS) ---
# Разрешённый источник запросов — ваш сайт на Tilda.
ALLOWED_ORIGIN=https://pinkrun.kz

# --- SMSC.kz ---
SMSC_LOGIN=ваш_логин_smsc
SMSC_PASSWORD=ваш_пароль_smsc

# --- BCC Pay (Bank CenterCredit) ---
# Значения выдаст банк после подключения через developer.bcc.kz
BCC_MERCHANT_ID=
BCC_API_KEY=
BCC_API_SECRET=
BCC_API_BASE_URL=

# --- Общее ---
PORT=3000
